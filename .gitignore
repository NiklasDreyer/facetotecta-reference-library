# Results and Snakemake's working folder (large, regenerated by the workflow)
results/
.snakemake/

# Raw sequencing data stay on the cluster; keep the empty folders
data/raw/**/*
!data/raw/**/
!data/raw/**/.keep

# Downloaded reference databases (MIDORI2, SILVA)
resources/db/*
!resources/db/README.txt
!resources/db/.keep

# Locally installed binaries (ASAP)
bin/

# Python and editor clutter
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/
